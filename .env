ROS_DOMAIN_ID=30
UR_TYPE=ur10
UR_IP=
UR_CALIBRATION_FILE=/config/ur_calibration.yaml
ALLOW_REAL_ROBOT=NO

# Safety default. Enable only during an observed mock-only validation run.
ENABLE_SERVO_OUTPUT=NO
VR_POSITION_SCALE=1.0
QUEST_FILTER_WINDOW=6
VR_TO_ROBOT_ROTATION=
ENABLE_ANGULAR_SERVO=YES
TELEOP_INPUT_TIMEOUT=0.25
TELEOP_TF_TIMEOUT=0.50
MAX_LINEAR_SPEED=0.025
MAX_ANGULAR_SPEED=0.10
