# Must be the same across any ROS 2 process that needs to discover these nodes.
ROS_DOMAIN_ID=30
# Choose ur10 (CB) or ur10e (e-Series).
UR_TYPE=ur10
# The actual UR controller's Ethernet IP. Never put the Quest/PC IP here.
UR_IP=
# Factory calibration extracted from this exact robot and mounted read-only.
UR_CALIBRATION_FILE=/config/ur_calibration.yaml
# Read-only calibration extraction timeout in seconds.
CALIBRATION_TIMEOUT=45
# Safety gate for the optional `ur_real` profile (not for normal Quest reception).
ALLOW_REAL_ROBOT=NO

# Default NO: bridge calculates/prints preview, never feeds MoveIt Servo.
# Enable ONLY after mock testing, axis calibration and operator approval.
ENABLE_SERVO_OUTPUT=NO

# Quest->UR calibration and bounded command settings. Leave the 3x3 matrix
# empty to calibrate from the controller/tool orientations on button_lower.
VR_POSITION_SCALE=1.0
QUEST_FILTER_WINDOW=6
VR_TO_ROBOT_ROTATION=
ENABLE_ANGULAR_SERVO=YES
TELEOP_INPUT_TIMEOUT=0.25
TELEOP_TF_TIMEOUT=0.50
MAX_LINEAR_SPEED=0.025
MAX_ANGULAR_SPEED=0.10
